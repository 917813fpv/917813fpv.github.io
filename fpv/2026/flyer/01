<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@71岁极品老登爽飞穿越机｜2026FPV参赛选手-个人网页赠送5年</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem;
            overflow-x: hidden;
            font-family: "微软雅黑", "Noto Sans SC", sans-serif;
        }
        /* 二次元装饰元素 */
        .anime-deco {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 0;
            pointer-events: none;
        }
        .anime-deco .star {
            position: absolute;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 50%;
            animation: twinkle 3s infinite alternate;
        }
        .anime-deco .ribbon {
            position: absolute;
            width: 100px;
            height: 20px;
            background: linear-gradient(90deg, #ff7eb6, #ff5e62);
            transform: rotate(45deg);
            top: 20%;
            left: -20px;
            animation: float 8s infinite alternate;
        }
        .anime-deco .ribbon::after {
            content: "";
            position: absolute;
            width: 20px;
            height: 20px;
            background: #ff5e62;
            right: -10px;
            border-radius: 50%;
        }
        /* 图片容器 */
        .img-container {
            position: relative;
            width: 80%;
            max-width: 800px;
            margin: 1.5rem 0;
            z-index: 1;
            animation: fadeInUp 1.2s ease-out;
        }
        .img-container img {
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(255, 126, 182, 0.5),
                        0 0 40px rgba(255, 94, 98, 0.3);
            transition: transform 0.5s ease;
        }
        .img-container:hover img {
            transform: scale(1.02);
        }
        /* 动画效果 */
        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes twinkle {
            0% {
                opacity: 0.3;
                transform: scale(0.8);
            }
            100% {
                opacity: 1;
                transform: scale(1.2);
            }
        }
        @keyframes float {
            0% {
                transform: rotate(45deg) translateY(0);
            }
            100% {
                transform: rotate(45deg) translateY(20px);
            }
        }
        /* 水印样式 */
        .watermark {
            position: fixed;
            bottom: 20px;
            right: 20px;
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.2rem;
            font-weight: bold;
            text-shadow: 0 0 8px rgba(255, 126, 182, 0.8);
            z-index: 2;
            animation: fadeIn 2s ease;
        }
        /* 响应式适配 */
        @media (max-width: 768px) {
            .img-container {
                width: 95%;
            }
            .watermark {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <!-- 二次元装饰背景 -->
    <div class="anime-deco">
        <div class="star" style="width: 3px; height: 3px; top: 10%; left: 20%; animation-delay: 0s;"></div>
        <div class="star" style="width: 2px; height: 2px; top: 30%; left: 70%; animation-delay: 0.5s;"></div>
        <div class="star" style="width: 4px; height: 4px; top: 50%; left: 40%; animation-delay: 1s;"></div>
        <div class="star" style="width: 2px; height: 2px; top: 80%; left: 60%; animation-delay: 1.5s;"></div>
        <div class="ribbon"></div>
    </div>

    <!-- 三人图容器 -->
    <div class="img-container">
        <img src="https://www.img520.com/RckJ3X.png" alt="三人角色图">
    </div>

    <!-- 爱莉希雅单独图容器 -->
    <div class="img-container" style="animation-delay: 0.5s;">
        <img src="https://www.img520.com/SSSq8Y.png" alt="爱莉希雅图">
    </div>

    <!-- 水印 -->
    <div class="watermark">2026FPV参赛选手@71岁极品老登爽飞穿越机</div>

    <script>
        // 动态生成更多星星装饰
        const deco = document.querySelector('.anime-deco');
        for (let i = 0; i < 20; i++) {
            const star = document.createElement('div');
            star.classList.add('star');
            star.style.width = `${Math.random() * 3 + 1}px`;
            star.style.height = star.style.width;
            star.style.top = `${Math.random() * 100}%`;
            star.style.left = `${Math.random() * 100}%`;
            star.style.animationDelay = `${Math.random() * 3}s`;
            deco.appendChild(star);
        }
    </script>
</body>
</html>
