            margin-bottom: 8px;
            background: #f8fafc;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 500;
            color: #334155;
            border: 1px solid #e2e8f0;
            transition: background 0.2s ease, color 0.2s ease;
        }
        .player-item:last-child {
            margin-bottom: 0;
        }
        .player-item:hover {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
        }
        .footer {
            text-align: center;
            padding: 40px 0;
            color: #64748b;
            font-size: 14px;
        }
        .footer strong {
            color: #2563eb;
        }

        /* ########### 仅修改以下部分 ########### */
        /* 1. 给卡片增加内边距，为域名留出底部空间 */
        .group-card {
            padding-bottom: 50px; /* 底部预留足够空白 */
        }
        /* 2. 域名样式：淡灰色、底部居中、上下留白 */
        .domain-tag {
            position: absolute;
            bottom: 12px; /* 距离底部12px */
            left: 0;
            width: 100%;
            text-align: center;
            padding: 0 24px;
        }
        .domain-tag a {
            font-size: 12px;
            color: #c0c4cc; /* 更淡的灰色，不突兀 */
            text-decoration: none;
            letter-spacing: 0.5px;
        }
        .domain-tag a:hover {
